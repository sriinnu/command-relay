{
  "name": "@commandrelay/protocol",
  "version": "0.1.0",
  "description": "Shared WebSocket protocol schema for CommandRelay",
  "keywords": [
    "commandrelay",
    "websocket",
    "protocol",
    "typescript"
  ],
  "homepage": "https://github.com/sriinnu/command-relay#readme",
  "bugs": {
    "url": "https://github.com/sriinnu/command-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriinnu/command-relay.git",
    "directory": "packages/commandrelay-protocol"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm exec -- node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
