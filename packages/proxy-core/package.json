{
  "name": "@commandrelay/proxy-core",
  "version": "0.1.0",
  "description": "Core proxy resolution utilities for CommandRelay and external projects",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
