{
  "name": "@commandrelay/relay-proxy",
  "version": "0.1.0",
  "description": "CommandRelay websocket relay proxy for exposing a single `/ws` endpoint through controlled transport paths",
  "keywords": [
    "commandrelay",
    "websocket",
    "proxy",
    "relay",
    "typescript",
    "nodejs"
  ],
  "homepage": "https://github.com/sriinnu/commandrelay#readme",
  "bugs": {
    "url": "https://github.com/sriinnu/command-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriinnu/command-relay.git",
    "directory": "packages/commandrelay-relay-proxy"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "commandrelay-relay-proxy": "./dist/cli.js"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm exec -- node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "cli": "node dist/cli.js",
    "test": "npm exec -- node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.test.json && npm exec -- node --test dist/**/*.test.js && npm exec -- node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
