{
  "name": "@commandrelay/proxy-fetch",
  "version": "0.1.0",
  "description": "Proxy-aware fetch wrappers with JSON safety limits and timeout controls",
  "keywords": [
    "commandrelay",
    "commandrelay",
    "proxy",
    "fetch",
    "undici",
    "typescript"
  ],
  "homepage": "https://github.com/sriinnu/command-relay#readme",
  "bugs": {
    "url": "https://github.com/sriinnu/command-relay/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sriinnu/command-relay.git",
    "directory": "packages/proxy-fetch"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/proxy-fetch/src/index.js",
  "module": "./dist/proxy-fetch/src/index.js",
  "types": "./dist/proxy-fetch/src/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/proxy-fetch/src/index.d.ts",
      "import": "./dist/proxy-fetch/src/index.js",
      "default": "./dist/proxy-fetch/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SKILL.md",
    "docs/assets/proxy-fetch-brand.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "npm exec -- node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.build.json",
    "test": "npm exec -- node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true });\" && tsc -p tsconfig.test.json && npm exec -- node --test dist/**/*.test.js && npm exec -- node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@commandrelay/proxy-undici": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  }
}
