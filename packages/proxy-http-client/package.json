{
  "name": "@commandrelay/proxy-http-client",
  "version": "0.1.0",
  "description": "Proxy-aware JSON HTTP client with timeout controls",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.json --noEmit false --outDir .test-dist && node --test .test-dist/test/request-json.test.js && node -e \"require('node:fs').rmSync('.test-dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
