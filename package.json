{
  "name": "commandrelay-bridge",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "description": "CommandRelay tmux bridge core engine",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "capsule:build": "tsx scripts/orchestration/build-task-capsule.ts",
    "capsule:brief": "tsx scripts/orchestration/build-agent-brief.ts",
    "capsule:dispatch": "tsx scripts/orchestration/build-agent-dispatch.ts",
    "orchestration:plan-audit": "bash scripts/orchestration/plan-mode-audit.sh",
    "discover:skills": "tsx scripts/extensions/list-discoverable-skills.ts",
    "discover:skills:json": "tsx scripts/extensions/list-discoverable-skills.ts --format json",
    "discover:apps": "tsx scripts/extensions/list-discoverable-apps.ts",
    "discover:apps:json": "tsx scripts/extensions/list-discoverable-apps.ts --format json",
    "extension:run": "tsx scripts/extensions/run-extension-cli.ts",
    "check": "pnpm run check:root && pnpm run check:orchestration",
    "check:root": "tsc --noEmit",
    "check:orchestration": "tsc --noEmit -p tsconfig.orchestration.json",
    "check:packages": "bash scripts/packages/run-phase.sh check",
    "check:all": "bash scripts/packages/run-phase.sh check --include-root --root-script check",
    "build": "pnpm run build:all",
    "build:packages": "node scripts/packages/run-phase-ordered.mjs build",
    "build:packages:ordered": "node scripts/packages/run-phase-ordered.mjs build",
    "build:packages:ordered:root": "node scripts/packages/run-phase-ordered.mjs build --include-root --root-script build:packages:ordered",
    "order:packages": "node scripts/packages/run-phase-ordered.mjs build --print-order",
    "build:all": "pnpm run build:packages",
    "test": "pnpm run test:root",
    "test:root": "tsx --test src/**/*.test.ts",
    "test:packages": "bash scripts/packages/run-phase.sh test",
    "test:all": "bash scripts/packages/run-phase.sh test --include-root --root-script test:root",
    "verify:consumer-smoke": "bash scripts/packages/verify-consumer-smoke.sh",
    "ci:packages": "pnpm run check:packages && pnpm run build:packages && pnpm run test:packages && pnpm run verify:consumer-smoke",
    "ci:check": "pnpm run build:packages && pnpm run check:all",
    "ci:build": "pnpm run build:all",
    "ci:test": "pnpm run test:all && pnpm run verify:consumer-smoke",
    "ci:all": "pnpm run ci:check && pnpm run ci:build && pnpm run ci:test",
    "test:ci:all": "bash scripts/ci-test-all.sh",
    "test:ci:web-smoke": "bash scripts/ci-test-target.sh web-smoke",
    "bench:connect": "tsx scripts/perf/connect-latency.ts",
    "bench:list": "tsx scripts/perf/list-sessions-roundtrip.ts",
    "bench:input": "tsx scripts/perf/input-ack-roundtrip.ts",
    "bench:soak:flaky": "tsx scripts/checkpoints/run-flaky-network-soak.ts",
    "release:proxy:lockstep": "tsx scripts/release/check-proxy-lockstep-versions.ts",
    "release:proxy:capture-governance": "bash scripts/release/capture-governance-evidence.sh",
    "release:proxy:capture-dry-run": "bash scripts/release/capture-proxy-dry-run-artifacts.sh",
    "release:proxy:preflight": "bash scripts/release/proxy-preflight.sh",
    "release:proxy:deterministic-validate": "bash scripts/release/deterministic-validate.sh",
    "release:proxy:guardrails": "pnpm run release:proxy:lockstep && pnpm run release:proxy:preflight"
  },
  "dependencies": {
    "@commandrelay/runtime-cmux": "workspace:^",
    "@commandrelay/runtime-core": "workspace:^",
    "@commandrelay/runtime-managed": "workspace:^",
    "@commandrelay/runtime-ssh": "workspace:^",
    "@commandrelay/runtime-tmux": "workspace:^",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "pac-proxy-agent": "^7.2.0",
    "socks-proxy-agent": "^8.0.5",
    "ws": "^8.18.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "basic-ftp": "5.2.2"
    }
  }
}
